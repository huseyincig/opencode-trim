{
  "name": "opencode-trim",
  "version": "0.12.6",
  "description": "Strict TypeScript OpenCode V2 plugin for deterministic tool-output compression, cache-aware context pruning, recoverable pruning vault, and FTS5 compaction memory",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/compress.d.ts",
      "default": "./dist/compress.js"
    },
    "./prune": {
      "types": "./dist/prune.d.ts",
      "default": "./dist/prune.js"
    },
    "./pressure": {
      "types": "./dist/pressure.d.ts",
      "default": "./dist/pressure.js"
    },
    "./rpc": {
      "types": "./dist/stats-rpc.d.ts",
      "default": "./dist/stats-rpc.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.3.0",
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/plugin": "^2.4.1",
    "@opentui/core": "^0.9.9",
    "@opentui/solid": "^0.9.9",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "^1.9.17",
    "solid-js": "^1.9.17",
    "typescript": "^5.8.0"
  },
  "files": [
    "index.ts",
    "dist/",
    "src/",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "AUDIT.md"
  ],
  "scripts": {
    "build": "node -e \"import('node:fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\" && tsc",
    "postbuild": "node scripts/emit-tui.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm run build && node scripts/check.ts && npm test",
    "bench": "node bench/bench.ts",
    "pack:dry": "npm pack --dry-run --json --ignore-scripts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-trim",
    "v2",
    "context",
    "pruning",
    "compaction",
    "compression",
    "memory",
    "sqlite",
    "fts5",
    "tui",
    "typescript"
  ]
}
